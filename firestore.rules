rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Each user can only read/write their own profile, wallet, orders and tickets.
    match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    // Anyone can browse listings; only the seller can create/change/delete their own.
    match /products/{pid} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerUid == request.auth.uid;
    }
  }
}
